{
  "name": "fofit-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && vite preview --host 127.0.0.1 --port 4173",
    "build": "python3 scripts/build-approved-marketing.py",
    "preview": "vite preview",
    "validate:copy": "node scripts/validate-copy.mjs",
    "validate:legal": "node scripts/validate-legal-pages.mjs",
    "verify:legal-live": "node scripts/verify-live-legal-routes.mjs",
    "dev:legacy": "vite",
    "build:legacy": "vite build --outDir legacy-dist",
    "validate:approved": "node scripts/check-approved-marketing.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.9.2",
    "vite": "^6.3.5"
  }
}
